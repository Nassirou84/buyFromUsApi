# Local HTTPS in front of the app. `tls internal` uses Caddy's own local CA
# (persisted in the caddy_data volume); trust its root cert once, see README note in compose.
https://localhost, https://127.0.0.1 {
	tls internal
	reverse_proxy buyfromus-api:80
}

# Production: Caddy obtains a Let's Encrypt certificate automatically.
# Needs DNS A record -> this server's IP and ports 80/443 reachable.
core.flotboutique.com {
	reverse_proxy buyfromus-api:80
}
