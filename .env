BREVO_SMS_SENDER=
EMAIL_QUEUE_BATCH_SIZE=
TFA_CODE_TEMPLATE_ID=
ORDER_CONFIRMATION_TEMPLATE_ID=
PASSWORD_RESET_TEMPLATE_ID=
PASSWORD_CHANGED_TEMPLATE_ID=
WELCOME_EMAIL_TEMPLATE_ID=
SHOPPING_REQUEST_CONFIRMATION_TEMPLATE_ID=
RETURN_REQUEST_CONFIRMATION_TEMPLATE_ID=

EXPRESS_SHIPPING_COST=
EXPRESS_SHIPPING_DURATION=

###> Frontend ###
PASSWORD_RESET_URL=
WEBSITE_NAME=
WEBSITE_TAGLINE=
COMPANY_ADDRESS=
FRONTEND_URL=
ADMIN_FRONTEND_URL=
ACCOUNT_VALIDATION_URL=
SUPPORT_EMAIL=
INSTAGRAM_URL=
FACEBOOK_URL=
TWITTER_URL=
TIKTOK_URL=
DRIVER_INTERFACE_URL=
SUPPORT_PATH=
SHOPPING_REQUEST_STATUS_PATH=
FAQS_PATH=
PRIVACY_POLICY_PATH=
GENERAL_TERMS_PATH=
CONTACT_US_PATH=
ABOUT_US_PATH=
COKIE_POLICY_PATH=

###> Google Cloud json key ###
GCP_KEY_FILE_PATH=
GCS_BUCKET_NAME=
###< Google Cloud json key ###

###> Google Secret Manager ###
GCP_PROJECT_ID=
###< Google Secret Manager ###

###> Google Cloud KMS ###
# Coordinates of the symmetric crypto key used by GoogleKmsService; real values in .env.local.
# The service account needs roles/cloudkms.cryptoKeyEncrypterDecrypter on the key.
# GCP_KMS_LOCATION is the key ring's location ("global" or a region such as europe-southwest1)
# and GCP_KMS_CRYPTO_KEY is the key id alone -- never a /cryptoKeyVersions/N suffix.
GCP_KMS_CRYPTO_KEY=
###< Google Cloud KMS ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
MESSENGER_TRANSPORT_DSN=redis://localhost:6379
###< symfony/messenger ###

###> Redis (cache) ###
REDIS_URL=redis://localhost:6379
###< Redis (cache) ###

###> RabbitMQ Custom Connection ###
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=
###< RabbitMQ Custom Connection ###

###> symfony/ai-gemini-platform ###
GEMINI_API_KEY=
GEMINI_PROJECT_NUMBER=
###< symfony/ai-gemini-platform ###


###> Admin Email Configuration ###
ADMIN_EMAIL=
###< Admin Email Configuration ###

###> Scrapper Service ###
SCRAPPER_SERVICE_URL=
SCRAPPER_PASSKEY=
###< Scrapper Service ###

###> Paystack payment security ###
# Comma-separated allowlist of Paystack webhook source IPs. Leave EMPTY to disable
# (the HMAC signature is still enforced). Paystack's published IPs are:
# 52.31.139.75,52.49.173.169,52.214.14.220
# Only enable once trusted proxies are configured so getClientIp() is the real sender.
PAYSTACK_WEBHOOK_IPS=
# Order amount at/above which a saved-card charge is routed to hosted checkout for
# interactive step-up auth (3DS/OTP) instead of an off-session charge. 0 = disabled.
SAVED_CARD_STEP_UP_THRESHOLD=0
###< Paystack payment security ###
